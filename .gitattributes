# Normalize all text to LF in the repo and working tree (Godot writes LF on every platform).
* text=auto eol=lf

# Godot text formats
*.gd       text eol=lf
*.gdshader text eol=lf
*.tscn     text eol=lf
*.tres     text eol=lf
*.godot    text eol=lf
*.import   text eol=lf
*.uid      text eol=lf
*.cfg      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.svg      text eol=lf

# Binary assets: never diff or convert
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.exr   binary
*.hdr   binary
*.glb   binary
*.gltf  binary
*.blend binary
*.fbx   binary
*.wav   binary
*.ogg   binary
*.mp3   binary
*.ttf   binary
*.otf   binary
*.res   binary
*.scn   binary
